    <string name="overlay_mode_drawer">抽屉</string>
    <string name="overlay_mode_drawer_warning_title">使用滑动抽屉？</string>
    <string name="overlay_mode_drawer_warning_body">在某些设备上，边缘滑动抽屉可能无响应，导致你被困在悬浮层中、无法从游戏内部关闭它。推荐使用悬浮图标选项。仍要使用抽屉吗？</string>
    <string name="overlay_mode_drawer_warning_confirm">使用抽屉</string>
    <string name="overlay_mode_drawer_warning_cancel">取消</string>
    <string name="section_hud">HUD</string>
    <string name="section_trusted_overlay">触摸穿透</string>
    <string name="param_trusted_overlay">受信任悬浮层（无障碍）</string>
    <string name="param_trusted_overlay_desc">将悬浮层作为受信任的无障碍表面承载，使触摸能够到达底层应用 — 适用于触摸会被拦截的严格设备（如 Orange Pi 5 Ultra）。代价：会话运行期间悬浮层会覆盖状态栏和导航栏，你无法下拉通知或点按主屏/返回。如果你的设备本就能穿透触摸，请保持关闭；仅在无法穿透时开启。需要启用 LSFG 无障碍服务。</string>
    <string name="section_capture_mode">采集模式</string>
    <string name="capture_mode_mediaprojection">MediaProjection</string>
    <string name="capture_mode_shizuku">Shizuku 采集</string>
    <string name="capture_mode_root">Root 采集</string>
    <string name="capture_mode_desc">MediaProjection 通过 Android 屏幕共享进行采集；Shizuku 和 Root 采集使用按目标 UID 过滤的特权采集路径，适用于 MediaProjection 画面包含悬浮层的设备。</string>
    <string name="param_frame_graph">帧节奏图表</string>
    <string name="param_frame_graph_desc">在悬浮层中实时绘制生成帧的间隔，可用于诊断卡顿。</string>

    <string name="dll_status_none">AI 插帧引擎已内置，无需外部文件。</string>
    <string name="dll_status_ready">AI 插帧引擎就绪（%1$s）。</string>
    <string name="dll_pick_button">AI 引擎已内置</string>
    <string name="dll_reextract_button">重新提取着色器</string>

    <string name="param_multiplier">帧倍率</string>
    <string name="param_multiplier_desc">每个真实帧生成的帧数。2 = 每对帧之间插入一帧。移动端建议 3–4。</string>
    <string name="param_flow_scale">光流缩放</string>
    <string name="param_flow_scale_desc">内部运动估算分辨率。越低 = 越快但精度越低。</string>
    <string name="param_performance_mode">性能模式（LSFG 3.1P）</string>
    <string name="param_performance_mode_desc">使用速度更快、画质略低的变体，推荐在中端 GPU 上使用。</string>
    <string name="param_hdr">HDR 模式</string>
    <string name="param_hdr_desc">仅在设备和游戏均输出 HDR 时启用。</string>
    <string name="param_anti_artifacts">抗伪影模式</string>
    <string name="param_anti_artifacts_desc">在镜头快速移动时抑制生成帧，以减少角色缺块和变形。默认关闭。</string>
    <string name="param_framegen_fp16">FP16 帧生成</string>
    <string name="param_framegen_fp16_desc">使用半精度（FP16）进行帧生成运算，代替全精度（FP32）。可降低 GPU 负载和内存带宽，画质几乎相同；如出现任何问题会自动回退到 FP32。</string>
    <string name="param_npu_post">NPU 图像增强</string>
    <string name="param_npu_post_desc_available">在专用加速器上完整运行手工构建的 NNAPI 图（非锐化遮罩、细节增强、色度洁净、游戏锐利）。设备：%1$s</string>
    <string name="param_npu_post_desc_unavailable">已禁用：Android 未报告专用的 NNAPI 加速器。设备：%1$s</string>
    <string name="param_npu_preset">NPU 预设</string>
    <string name="npu_preset_off">关闭</string>
    <string name="npu_preset_sharpen">锐化</string>
    <string name="npu_preset_detail_boost">细节</string>
    <string name="npu_preset_chroma_clean">洁净</string>
    <string name="npu_preset_game_crisp">游戏</string>
    <string name="param_npu_amount">NPU 强度</string>
    <string name="param_npu_amount_desc">增强内核的强度。值越高画面越清晰，但可能放大压缩伪影。</string>
    <string name="param_npu_radius">NPU 半径</string>
    <string name="param_npu_radius_desc">非锐化遮罩路径使用的模糊半径。半径越大越凸显大边缘；半径越小越针对精细细节。</string>
    <string name="param_npu_upscale">NPU 放大倍率</string>
    <string name="param_npu_upscale_desc">1x 保持输出尺寸不变；2x 在增强处理前请求 NPU 双线性放大。</string>

    <string name="param_cpu_post">CPU 后处理</string>
    <string name="param_cpu_post_desc">在 NPU 阶段之后执行的纯 CPU 像素处理。开销低、始终可用，并可在预设基础上调节饱和度、自然饱和度和暗角。</string>
    <string name="param_cpu_preset">CPU 预设</string>
    <string name="cpu_preset_off">关闭</string>
    <string name="cpu_preset_enhance_lut">增强</string>
    <string name="cpu_preset_warm">暖色</string>
    <string name="cpu_preset_cool">冷色</string>
    <string name="cpu_preset_vignette">暗角</string>
    <string name="cpu_preset_gamer_sharp">锐利</string>
    <string name="cpu_preset_cinematic">电影感</string>
    <string name="param_cpu_strength">CPU 强度</string>
    <string name="param_cpu_strength_desc">控制当前 CPU 预设的主要数值（对比度增强、锐化量、电影感混合……）。</string>
    <string name="param_cpu_saturation">饱和度</string>
    <string name="param_cpu_saturation_desc">0 为完全去饱和；50 为中性；满值让色彩更鲜艳。</string>
    <string name="param_cpu_vibrance">自然饱和度</string>
    <string name="param_cpu_vibrance_desc">提升低饱和度像素，同时避免过度增强本已鲜艳的部分。适合发灰的 HUD 和肤色。</string>
    <string name="param_cpu_vignette">暗角</string>
    <string name="param_cpu_vignette_desc">从半径 60% 处开始，以余弦衰减压暗四角。</string>
    <string name="param_gpu_post">GPU 放大/增强</string>
    <string name="param_gpu_post_desc">使用 Vulkan GPU 后处理方法进行图像放大与增强。</string>
    <string name="param_gpu_stage">GPU 处理顺序</string>
    <string name="gpu_stage_before_lsfg">真实帧优先</string>
    <string name="gpu_stage_after_lsfg">最终悬浮帧</string>
    <string name="param_gpu_method">GPU 方法</string>
    <string name="gpu_method_fsr1">FSR 1 EASU + RCAS</string>
    <string name="gpu_method_cas">AMD CAS</string>
    <string name="gpu_method_nis">NVIDIA NIS</string>
    <string name="gpu_method_lanczos">Lanczos</string>
    <string name="gpu_method_bicubic">双三次</string>
    <string name="gpu_method_bilinear">双线性</string>
    <string name="gpu_method_catmull">Catmull-Rom</string>
    <string name="gpu_method_mitchell">Mitchell-Netravali</string>
    <string name="gpu_method_anime4k_fast">Anime4K 快速</string>
    <string name="gpu_method_anime4k_restore">Anime4K 修复</string>
    <string name="gpu_method_xbrz">xBRZ</string>
    <string name="gpu_method_edge_directed">边缘导向</string>
    <string name="gpu_method_unsharp">非锐化遮罩</string>
    <string name="gpu_method_luma">亮度锐化</string>
    <string name="gpu_method_contrast">对比度自适应</string>
    <string name="gpu_method_deband">去色带</string>
    <string name="param_gpu_upscale">GPU 放大倍率</string>
    <string name="param_gpu_upscale_desc">控制放大类方法请求的输出倍率。</string>
    <string name="param_gpu_sharpness">GPU 锐度</string>
    <string name="param_gpu_sharpness_desc">控制 RCAS/NIS/CAS 类锐化的强度。</string>
    <string name="param_gpu_strength">GPU 增强强度</string>
    <string name="param_gpu_strength_desc">控制非缩放类增强处理的强度。</string>
    <string name="param_fps_counter">悬浮层 FPS 计数器</string>
    <string name="param_fps_counter_desc">在悬浮层左上角显示小型 FPS 读数。MediaProjection 统计可见的采集帧；Shizuku 采集统计按目标 UID 过滤的特权帧。</string>
    <string name="param_drawer_edge">抽屉把手位置</string>
    <string name="param_drawer_edge_desc">选择游戏内抽屉把手在悬浮层上的显示位置。</string>
    <string name="drawer_edge_left">左</string>
    <string name="drawer_edge_right">右</string>
    <string name="drawer_edge_top">上</string>
