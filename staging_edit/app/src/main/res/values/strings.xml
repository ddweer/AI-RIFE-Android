    <!-- Benchmark mode -->
    <string name="benchmark_title">基准测试模式</string>
    <string name="benchmark_home_button">运行基准测试</string>
    <string name="benchmark_intro">连续运行三轮测试（倍率 ×2、×3、×4），使用固定预设并生成可分享的报告。在性能调整前后运行，以此为基线衡量变化。</string>
